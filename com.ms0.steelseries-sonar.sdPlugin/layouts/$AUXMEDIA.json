            "subtype": 4,
            "border_w": 0
        },
        {
            "key": "mediaLabel",
            "type": "text",
            "rect": [16, 64, 50, 18],
            "font": { "size": 13, "weight": 600 },
            "alignment": "left"
        },
        {
            "key": "mediaIndicator",
            "type": "bar",
            "rect": [70, 68, 112, 12],
            "value": 0,
            "subtype": 4,
            "border_w": 0
        }
    ]
}
